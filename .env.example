# ---------------------------------------------------------------------------
# NeuroNest backend — environment template.
# Copy to `.env` and fill real values. Never commit `.env`.
# All variables are validated at boot (src/common/config/env.validation.ts).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
# Public URL of the web/app front end — used to build links inside emails.
APP_WEB_URL=http://localhost:5173
# Browser origins allowed to call this API (CORS), comma-separated, no spaces needed.
# Each entry must be an exact origin: scheme://host[:port] — no path, no trailing slash,
# no wildcard (e.g. "https://app.example.com", not "https://app.example.com/").
# Add your deployed front-end URL here. Empty = no cross-origin browser access;
# required in production. Non-browser clients (curl, mobile, server-to-server) and
# same-origin pages (the /docs reference) are unaffected by this list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://neuronest:neuronest@localhost:5432/neuronest?schema=public
# Unpooled connection for the Prisma CLI (`migrate`/`db push`) — see database-and-docker.md.
# Local Docker Postgres has no pooler in front of it, so this is the same value as
# DATABASE_URL. Pointing DATABASE_URL at a pooled host (e.g. Neon)? Set this to that
# same host's *unpooled* connection string instead — never leave it blank once
# DATABASE_URL is pooled, or `migrate`/`db push` will fail against an empty URL.
DATABASE_DIRECT_URL=postgresql://neuronest:neuronest@localhost:5432/neuronest?schema=public
# Required for `npm run test:e2e` — global-setup.ts throws if unset, no fallback to
# DATABASE_URL. Must point at local Docker Postgres, never at Neon or any database
# you care about: the suite truncates every table between specs, and this same value
# overrides *both* DATABASE_URL and DATABASE_DIRECT_URL for the pre-flight
# `migrate deploy` (see docs/database-and-docker.md §7 for why both). The
# `neuronest_test` database itself is auto-created on first `npm run docker:up`
# by docker/initdb/01-create-test-db.sql — no manual `CREATE DATABASE` step needed.
TEST_DATABASE_URL=postgresql://neuronest:neuronest@localhost:5432/neuronest_test?schema=public

# Access-token signing (refresh tokens are opaque, not JWTs — no secret needed)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# argon2id parameters
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Verification / reset token lifetimes
EMAIL_VERIFICATION_TTL_MIN=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MIN=60
# Lifetime of the account-setup link emailed to a provisioned (INVITED) clinician.
ACCOUNT_SETUP_TTL_MIN=60

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="NeuroNest <no-reply@neuronest.example>"

# Media storage (Cloudinary). Required in production; local/test use the Fake
# media storage service and never need real credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (generous global default; /v1/auth/* is fixed at 5 req / 60s in code)
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=100

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# First admin account — consumed only by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=NeuroNest Admin
