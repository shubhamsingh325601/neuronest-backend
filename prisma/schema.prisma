// NeuroNest — Prisma schema (Phase 1).
// See docs/schema-decisions.md for the rationale behind every table and field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  PARENT
  CLINICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  INVITED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_RESET_CODE
  ACCOUNT_SETUP
}

enum VerificationChannel {
  EMAIL
}

enum MediaType {
  PHOTO
  VIDEO
}

enum MediaStatus {
  PENDING
  UPLOADED
  FAILED
}

enum MediaProvider {
  CLOUDINARY
}

enum PlanTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PlanOrigin {
  MANUAL
  AI
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  name            String
  role            Role       @default(PARENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  selfExcludedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  child                   Child?                     @relation("ChildParent")
  clinicianAssignments    ClinicianChildAssignment[] @relation("ClinicianAssignments")
  assignmentsMadeAsAdmin  ClinicianChildAssignment[] @relation("AssignmentsMadeByAdmin")
  uploadedMedia           Media[]                    @relation("UploadedMedia")
  planTemplatesCreated    PlanTemplate[]             @relation("PlanTemplatesCreated")
  plansCreated            Plan[]                     @relation("PlansCreated")
  planNotesAuthored       PlanNote[]                 @relation("PlanNotesAuthored")
  monthlyCallLogsLogged   MonthlyCallLog[]           @relation("MonthlyCallLogsLogged")
  clinicianProfile        ClinicianProfile?          @relation("ClinicianProfileUser")
  mediaConsentsGranted    MediaConsent[]             @relation("MediaConsentsGranted")
  coachingTipsAuthored    CoachingTip[]              @relation("CoachingTipsAuthored")
  progressEntriesCreated  ProgressEntry[]            @relation("ProgressEntriesCreated")
  appointmentSlotsOwned   AppointmentSlot[]          @relation("AppointmentSlotsOwned")
  appointmentSlotsCreated AppointmentSlot[]          @relation("AppointmentSlotsCreated")
  appointmentsMade        Appointment[]              @relation("AppointmentsMade")
  activityCompletionsMade ActivityCompletion[]       @relation("ActivityCompletionsMade")
  escalationsRaised       Escalation[]               @relation("EscalationsRaised")
  escalationsHandled      Escalation[]               @relation("EscalationsHandled")
  preferences             UserPreference?

  @@map("users")
}

/// A parent's notification and archive choices. No row means the defaults below.
model UserPreference {
  userId                String   @id @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachingInApp         Boolean  @default(true)
  coachingEmail         Boolean  @default(false)
  coachingWhatsapp      Boolean  @default(false)
  appointmentReminders  Boolean  @default(true)
  consultationArchive   Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("user_preferences")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @db.Uuid
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationTokenType
  channel    VerificationChannel   @default(EMAIL)
  tokenHash  String
  attempts   Int                   @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, type])
  @@index([tokenHash])
  @@map("verification_tokens")
}

/// Admin-visible profile for a CLINICIAN user (plan 0010). 1:1, optional: legacy
/// clinicians created via the old approve flow have no row.
model ClinicianProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation("ClinicianProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  specialisation String?
  qualifications String?
  licenseNumber  String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("clinician_profiles")
}

model Child {
  id              String   @id @default(uuid()) @db.Uuid
  parentId        String   @unique @db.Uuid
  parent          User     @relation("ChildParent", fields: [parentId], references: [id], onDelete: Cascade)
  name            String
  dateOfBirth     DateTime @db.Date
  // Parent-editable profile fields (plan 0017 batch A).
  preferredName   String?
  gender          String?
  primaryLanguage String?
  accommodations  String?
  // Clinician-authored profile (strengths, sensory traits, calming preferences, communication);
  // read by the parent, written only by an assigned clinician or admin.
  clinicalProfile Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinicianAssignments ClinicianChildAssignment[]
  media                Media[]
  plans                Plan[]
  monthlyCallLogs      MonthlyCallLog[]
  mediaConsents        MediaConsent[]
  coachingTips         CoachingTip[]
  progressEntries      ProgressEntry[]
  appointments         Appointment[]
  activityCompletions  ActivityCompletion[]
  escalations          Escalation[]

  @@map("children")
}

model ClinicianChildAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  clinicianId       String   @db.Uuid
  clinician         User     @relation("ClinicianAssignments", fields: [clinicianId], references: [id], onDelete: Cascade)
  childId           String   @db.Uuid
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  assignedByAdminId String   @db.Uuid
  assignedByAdmin   User     @relation("AssignmentsMadeByAdmin", fields: [assignedByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@unique([clinicianId, childId])
  @@index([childId])
  @@map("clinician_child_assignments")
}

model Media {
  id              String        @id @default(uuid()) @db.Uuid
  childId         String        @db.Uuid
  child           Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  uploadedById    String        @db.Uuid
  uploadedBy      User          @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: Restrict)
  type            MediaType
  provider        MediaProvider @default(CLOUDINARY)
  storageKey      String
  status          MediaStatus   @default(PENDING)
  mimeType        String?
  durationSeconds Int?
  sizeBytes       Int?
  context         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt


  @@index([childId])
  @@map("media")
}

model PlanTemplate {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      PlanTemplateStatus @default(DRAFT)
  createdById String             @db.Uuid
  createdBy   User               @relation("PlanTemplatesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  days     PlanTemplateDay[]
  sections PlanTemplateSection[]
  plans    Plan[]

  @@map("plan_templates")
}

model PlanTemplateSection {
  id             String            @id @default(uuid()) @db.Uuid
  planTemplateId String            @db.Uuid
  planTemplate   PlanTemplate      @relation(fields: [planTemplateId], references: [id], onDelete: Cascade)
  title          String
  position       Int
  days           PlanTemplateDay[]

  @@unique([planTemplateId, position])
  @@map("plan_template_sections")
}

model PlanTemplateDay {
  id             String               @id @default(uuid()) @db.Uuid
  planTemplateId String               @db.Uuid
  planTemplate   PlanTemplate         @relation(fields: [planTemplateId], references: [id], onDelete: Cascade)
  sectionId      String?              @db.Uuid
  section        PlanTemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dayNumber      Int
  title          String
  instructions   String

  @@unique([planTemplateId, dayNumber])
  @@map("plan_template_days")
}

/// At most one ACTIVE plan per child: a partial unique index `plans_one_active_per_child`
/// ("childId" WHERE status = 'ACTIVE'), hand-written in migration
/// 20261004180000_plans_one_active_per_child. Prisma cannot model it - do NOT drop it.
model Plan {
  id             String       @id @default(uuid()) @db.Uuid
  childId        String       @db.Uuid
  child          Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  planTemplateId String       @db.Uuid
  planTemplate   PlanTemplate @relation(fields: [planTemplateId], references: [id], onDelete: Restrict)
  status         PlanStatus   @default(ACTIVE)
  origin         PlanOrigin   @default(MANUAL)
  startDate      DateTime     @db.Date
  createdById    String       @db.Uuid
  createdBy      User         @relation("PlansCreated", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notes           PlanNote[]
  days            PlanDay[]
  sections        PlanSection[]
  coachingTips    CoachingTip[]
  progressEntries ProgressEntry[]
  weeks           PlanWeek[]

  @@index([childId])
  @@map("plans")
}

/// Plan-owned copy of a template section, written on assign (snapshot — plan 0016).
model PlanSection {
  id       String    @id @default(uuid()) @db.Uuid
  planId   String    @db.Uuid
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  title    String
  position Int
  days     PlanDay[]

  @@unique([planId, position])
  @@map("plan_sections")
}

/// Plan-owned day content: copied from the template on assign, then editable per child.
model PlanDay {
  id           String       @id @default(uuid()) @db.Uuid
  planId       String       @db.Uuid
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionId    String?      @db.Uuid
  section      PlanSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dayNumber    Int
  title        String
  instructions String
  updatedById  String?      @db.Uuid
  updatedAt    DateTime     @updatedAt

  @@unique([planId, dayNumber])
  @@map("plan_days")
}

model PlanNote {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation("PlanNotesAuthored", fields: [authorId], references: [id], onDelete: Restrict)
  note      String
  createdAt DateTime @default(now())

  @@index([planId])
  @@map("plan_notes")
}

model MonthlyCallLog {
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @db.Uuid
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  clinicianId String   @db.Uuid
  clinician   User     @relation("MonthlyCallLogsLogged", fields: [clinicianId], references: [id], onDelete: Restrict)
  calledAt    DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([childId])
  @@map("monthly_call_logs")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
}

/// Transactional outbox + queue (plan 0011). One row per unit of background work; claimed
/// with FOR UPDATE SKIP LOCKED. `payload` never holds a secret — handlers mint tokens at
/// run time. `type` is plain text validated against the in-code handler registry.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  dedupeKey   String?   @unique
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority(sort: Desc), runAt])
  @@map("jobs")
}

/// Append-only parent media-consent history (plan 0012). The open row (neither withdrawn nor
/// superseded) is the current consent; a partial unique index (hand-written in the
/// migration) allows at most one open row per child. `consentVersion` is opaque — wording
/// lives in the frontend (D-2).
model MediaConsent {
  id             String    @id @default(uuid()) @db.Uuid
  childId        String    @db.Uuid
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  grantedById    String    @db.Uuid
  grantedBy      User      @relation("MediaConsentsGranted", fields: [grantedById], references: [id], onDelete: Restrict)
  consentVersion String
  grantedAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([childId, grantedAt])
  @@map("media_consents")
}

/// Manually authored weekly coaching tip, per child + plan + week (plan 0012).
model CoachingTip {
  id         String   @id @default(uuid()) @db.Uuid
  childId    String   @db.Uuid
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  planId     String   @db.Uuid
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber Int
  position   Int
  title      String
  body       String
  /// Optional richer guidance the care team can add to a tip.
  whyItMatters  String?
  steps         String[] @default([])
  scriptQuote   String?
  scriptContext String?
  authorId   String   @db.Uuid
  author     User     @relation("CoachingTipsAuthored", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, weekNumber, position])
  @@index([childId, weekNumber])
  @@map("coaching_tips")
}

/// Per-child daily progress (plan 0013). Plan-independent: `planId` is only a nullable
/// stamp of the ACTIVE plan at first write. Range CHECK constraints (mood/behaviour 1-5,
/// sleepMinutes 0-1440, note <= 1000) are hand-written in migration
/// add_progress_entries - Prisma cannot model them, do NOT drop them.
model ProgressEntry {
  id           String   @id @default(uuid()) @db.Uuid
  childId      String   @db.Uuid
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  planId       String?  @db.Uuid
  plan         Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  entryDate    DateTime @db.Date
  mood         Int?
  behaviour    Int?
  sleepMinutes Int?
  note         String?
  createdById  String   @db.Uuid
  createdBy    User     @relation("ProgressEntriesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([childId, entryDate])
  @@index([childId, entryDate(sort: Desc)])
  @@map("progress_entries")
}

/// Published availability of one clinician (plan 0014). Bookable by at most one
/// Appointment (Appointment.slotId is UNIQUE).
model AppointmentSlot {
  id          String   @id @default(uuid()) @db.Uuid
  clinicianId String   @db.Uuid
  clinician   User     @relation("AppointmentSlotsOwned", fields: [clinicianId], references: [id], onDelete: Restrict)
  startsAt    DateTime
  endsAt      DateTime
  createdById String   @db.Uuid
  createdBy   User     @relation("AppointmentSlotsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  /// Video-call link the clinician publishes with the slot; shown to the parent who books it.
  meetingUrl  String?
  createdAt   DateTime @default(now())

  appointment Appointment?

  @@unique([clinicianId, startsAt])
  @@index([clinicianId, startsAt])
  @@map("appointment_slots")
}

/// A parent's booking of a slot. `slotId` UNIQUE is the database-enforced double-booking guard.
model Appointment {
  id         String          @id @default(uuid()) @db.Uuid
  slotId     String          @unique @db.Uuid
  slot       AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  childId    String          @db.Uuid
  child      Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  bookedById String          @db.Uuid
  bookedBy   User            @relation("AppointmentsMade", fields: [bookedById], references: [id], onDelete: Restrict)
  /// What the parent wants to cover (plan goal ids) and which preparation steps they ticked.
  prepTopicIds     String[] @default([])
  prepChecklistIds String[] @default([])
  /// Written by the clinician after the call.
  summary      String?
  actionPoints String[] @default([])
  createdAt  DateTime        @default(now())

  @@index([childId])
  @@map("appointments")
}

// ---- Structured care-plan content (plan 0017 batch B) ----------------------------------

/**
 * One week of a plan: focus, optional parent guidance, goals and scheduled activities.
 */
model PlanWeek {
  id         String @id @default(uuid()) @db.Uuid
  planId     String @db.Uuid
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String
  focus      String
  // { title, scriptSnippet, practicalTip, context } — parent coaching for the week.
  guidance   Json?

  goals      PlanGoal[]
  activities PlanActivity[]

  @@unique([planId, weekNumber])
  @@map("plan_weeks")
}

model PlanGoal {
  id          String   @id @default(uuid()) @db.Uuid
  weekId      String   @db.Uuid
  week        PlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String
  domain      String
  icon        String?

  @@unique([weekId, position])
  @@map("plan_goals")
}

model PlanActivity {
  id                  String   @id @default(uuid()) @db.Uuid
  weekId              String   @db.Uuid
  week                PlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  position            Int
  // 1..7 — the day of the plan week the activity is scheduled for.
  dayOfWeek           Int
  title               String
  shortDescription    String
  goalCategory        String
  domain              String
  durationMinutes     Int
  whyItMatters        String
  // [{ title, instruction, tip? }]
  steps               Json
  // { title, scriptQuote, tip, context? }
  parentScript        Json?
  equipment           Json
  clinicalReassurance String?

  completion ActivityCompletion?

  @@unique([weekId, position])
  @@map("plan_activities")
}

/**
 * A parent marking an activity done. One row per activity; deleting the row resets it.
 */
model ActivityCompletion {
  id            String       @id @default(uuid()) @db.Uuid
  activityId    String       @unique @db.Uuid
  activity      PlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  childId       String       @db.Uuid
  child         Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  completedById String       @db.Uuid
  completedBy   User         @relation("ActivityCompletionsMade", fields: [completedById], references: [id], onDelete: Restrict)
  note          String?
  completedAt   DateTime     @default(now())

  @@index([childId])
  @@map("activity_completions")
}

// ---- Parent-raised escalations (plan 0017 batch F, adapted from plan 0015) ---------------
// An urgent-support request raised by the parent. Clinicians only review and resolve it; there is no
// chat. `dueAt` is stored (createdAt + 24 h); "overdue" is computed.

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model Escalation {
  id             String           @id @default(uuid()) @db.Uuid
  childId        String           @db.Uuid
  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  raisedById     String           @db.Uuid
  raisedBy       User             @relation("EscalationsRaised", fields: [raisedById], references: [id], onDelete: Restrict)
  categoryId     String
  notes          String
  whatWasTried   String?
  callbackPhone  String?
  status         EscalationStatus @default(OPEN)
  dueAt          DateTime
  acknowledgedAt DateTime?
  handledById    String?          @db.Uuid
  handledBy      User?            @relation("EscalationsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([childId, createdAt])
  @@index([status, dueAt])
  @@map("escalations")
}
